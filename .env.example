# ============================================================
# NarratorAI Web — Environment Variables
# ============================================================
# Copy to .env.local for local development:  cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All other variables are SERVER-SIDE ONLY (API routes, server.ts).
#
# NEVER commit .env.local or .env with real credentials.
# ============================================================

# ── Server Environment ──────────────────────────────────────
# Controls dev/prod behavior in server.ts and layout.tsx.
# Values: DEV | UAT | PROD
APP_ENV=DEV

# ── Backend API (server-side) ───────────────────────────────
# The upstream NarratorAI-compatible OpenAPI base URL.
# Use your own provider URL. Example: https://api.example.com
NARRATORAI_BASE_URL=http://localhost:8000
NARRATORAI_API_KEY=

# ── Pricing API (server-side) ───────────────────────────────
# Hard-price lookup / pricing backend base URL. REQUIRED — the lib clients
# in src/lib/*-backend-client.ts throw at first call if this is unset.
# Local dev: point to your locally running backend (default http://localhost:8000).
# Deploy: set via your hosting platform's secret manager.
NARRATOR_PRICING_API_URL=

# Bearer token for backend endpoints that proxy upstream (consume upstream
# quota). MUST match the value of `PRICING_BFF_AUTH_TOKEN` set on the
# narrator-ai-web-backend fly app via `fly secrets set ...`. Without this,
# narrator-metadata routes (`/narrator/types` / `/narrator/bgm` / ...) may
# return 401. Local dev: copy from .env.local.
PRICING_BFF_AUTH_TOKEN=

# ── Feature Flags — Server-side (preferred) ─────────────────
# These are read at REQUEST TIME by /api/narrator/feature-flags.
# Change and restart to take effect — no rebuild needed.
HARD_PRICE_ROLLOUT_PERCENT=0
HARD_PRICE_KILL_SWITCH=false

# ── Feature Flags — Client-side (legacy, fallback) ──────────
# Baked into JS bundle at build time. Changing requires rebuild.
# Prefer the server-side vars above. These are kept for backwards compat.
NEXT_PUBLIC_HARD_PRICE_ROLLOUT_PERCENT=0
NEXT_PUBLIC_HARD_PRICE_KILL_SWITCH=false

# ── Client-side URLs ────────────────────────────────────────
# NEXT_PUBLIC_ vars are embedded in the browser JS bundle.

# Frontend origin (for absolute URL generation, share links, etc.)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SSE endpoint (defaults to NARRATORAI_BASE_URL if not set)
# NEXT_PUBLIC_SSE_BASE_URL=


# ── MySQL (master task persistence) ────────────────────────
# Optional MySQL connection settings. Credentials must NEVER be committed.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── Runtime ─────────────────────────────────────────────────
# Server port (used by server.ts)
# PORT=5000

# Opt out of Turbopack at dev time. Turbopack on Next 16 has crashed on some
# Windows hosts with STATUS_DLL_INIT_FAILED (0xc0000142) when spawning
# webpack-loader worker processes. Set to "webpack" to force webpack-based dev.
# Set to "turbopack" to force Turbopack (same as default). Unset → Next default.
# No effect on prod build/serve.
# NEXT_DEV_BUNDLER=webpack
